@mastersthesis{schumann2025rl_call_center,
  author    = {Schumann, Marvin},
  title     = {Reinforcement Learning for Call Center Agent Routing: An Action Masking Approach},
  school    = {Nova School of Business and Economics},
  year      = {2025},
  type      = {Master's Thesis},
  address   = {Lisbon, Portugal},
  month     = {January},
  keywords  = {Reinforcement Learning, Call Centers, Action Masking, Agent Routing, Operations Research, MaskablePPO},
  abstract  = {This thesis investigates the application of Reinforcement Learning to optimize call center agent routing, with a focus on action masking for constraint enforcement. We develop a custom Gymnasium environment simulating call center operations and demonstrate that action masking is critical for RL success, achieving 104\% efficiency with Masked PPO compared to <2\% efficiency without masking. Comparative analysis with DQN confirms the problem is algorithm-independent, and we validate that Masked PPO is the only viable RL solution among available implementations.}
}

